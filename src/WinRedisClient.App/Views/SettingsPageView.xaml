<UserControl x:Class="WinRedisClient.App.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
             xmlns:vm="clr-namespace:WinRedisClient.Presentation.ViewModels;assembly=WinRedisClient.Presentation"
             Background="Transparent">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列 -->
                <StackPanel Grid.Column="0">
                    <!-- 外观 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '外观'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                            <TextBlock Text="{loc:Tr '主题配色'}" FontSize="{DynamicResource Fs125}" />
                            <TextBlock Text="{loc:Tr '低饱和度配色，选择后立即应用并保存'}" Style="{StaticResource TinyText}"
                                       Margin="0,3,0,0" />
                            <ListBox ItemsSource="{Binding ThemeOptions}"
                                     SelectedItem="{Binding SelectedThemeOption}"
                                     Background="Transparent" BorderThickness="0" Margin="0,10,0,10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="Padding" Value="5" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{DynamicResource BgInputBrush}"
                                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                                            BorderThickness="1" CornerRadius="9"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource BgSidebarHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryBrush}" />
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource PrimaryLightBrush}" />
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="Bd" Property="Padding" Value="4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThemeOptionViewModel}">
                                        <Grid ToolTip="{Binding Description}"
                                              AutomationProperties.Name="{Binding Name}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="6"
                                                    Background="{Binding AppColor, Converter={StaticResource StringToBrush}}">
                                                <Grid ClipToBounds="True">
                                                    <Border Width="24" HorizontalAlignment="Left"
                                                            Background="{Binding SidebarColor, Converter={StaticResource StringToBrush}}"
                                                            CornerRadius="6,0,0,6" />
                                                    <Border Width="28" HorizontalAlignment="Right"
                                                            Background="#222A3A" CornerRadius="0,6,6,0"
                                                            Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                                                    <Border Width="38" Height="22" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" CornerRadius="4"
                                                            Background="{Binding CardColor, Converter={StaticResource StringToBrush}}" />
                                                    <Border Width="18" Height="3" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                            Margin="0,0,0,6"
                                                            Background="{Binding AccentColor, Converter={StaticResource StringToBrush}}" />
                                                    <Ellipse Width="7" Height="7" HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom" Margin="0,0,7,6"
                                                             Fill="{Binding AccentColor, Converter={StaticResource StringToBrush}}" />
                                                    <Border x:Name="SelMark" Width="14" Height="14" CornerRadius="7"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,4,4,0" Visibility="Collapsed"
                                                            Background="{DynamicResource PrimaryBrush}">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="{DynamicResource Fs75}"
                                                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,6,1,0">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="{DynamicResource Fs9}" Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Value="True">
                                                <Setter TargetName="SelMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '界面语言'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '切换后需要重启 WinRedis 生效'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboModern}" Width="132" Height="32"
                                          MinHeight="32" ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '界面字体大小'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '小 / 标准 / 大，选择后立即应用到全部界面并保存'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboModern}" Width="150" Height="32"
                                          MinHeight="32" ItemsSource="{Binding FontSizeOptions}"
                                          SelectedItem="{Binding SelectedFontSize}" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '目录视图'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '按分隔符把 Key 聚合为客户端虚拟目录'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding UseDirectoryView}" Content="" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'Key 分隔符'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '用于目录视图拆分，例如 : 或 /'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource InputMono}" Width="110" Height="32"
                                         MinHeight="32" Text="{Binding KeySeparator, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '显示 Key 体积'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '使用 MEMORY USAGE 采样，大量 Key 时略增加扫描耗时'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding ShowKeySize}" Content="" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 浏览 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '浏览与连接'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '默认数据库'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '新建连接时默认选中的 DB'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboModern}" Width="96" Height="32"
                                          MinHeight="32" ItemsSource="{Binding DatabaseOptions}"
                                          SelectedItem="{Binding DefaultDatabase}" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '关闭主窗口时'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '每次询问、最小化到系统托盘继续后台运行，或直接退出'}"
                                               Style="{StaticResource TinyText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Style="{StaticResource ComboModern}" Width="150" Height="32"
                                          MinHeight="32" ItemsSource="{Binding CloseActionOptions}"
                                          SelectedItem="{Binding SelectedCloseAction}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 安全 -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '安全'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '生产环境写操作二次确认'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '删除、批量、FLUSH 等高危命令始终需要确认，此选项额外覆盖生产环境的所有写操作。'}"
                                               Style="{StaticResource TinyText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding ConfirmProductionWrites}" Content="" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 品牌 / 关于 -->
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/winredis-icon-128.png"
                                   Width="38" Height="38" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="WinRedis" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="{DynamicResource Fs16}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Win" /><Run Text="Redis" Foreground="{DynamicResource PrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="REDIS DESKTOP CLIENT" FontSize="{DynamicResource Fs75}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                                <TextBlock Text="{loc:Tr '本地优先的现代化 Redis 桌面客户端'}" Style="{StaticResource TinyText}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右列 -->
                <StackPanel Grid.Column="2">
                    <!-- 监控 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '实例监控'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '采样间隔'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '1–60 秒；仅页面可见时采样'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource InputMono}" Width="96" Height="32"
                                         MinHeight="32" Text="{Binding MonitorIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '自动刷新'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '打开监控页时自动开始采样'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding AutoRefreshMonitoring}" Content="" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 历史与隐私 -->
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '历史与隐私'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '记录最近访问 Key'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '仅保存在本机，可随时关闭与清空'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding RecentKeysEnabled}" Content="" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '记录命令历史'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '认证类命令永不记录；可在最近与历史页清空'}" Style="{StaticResource TinyText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding CommandHistoryEnabled}" Content="" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '命令历史上限'}" FontSize="{DynamicResource Fs125}" />
                                    <TextBlock Text="{loc:Tr '20–2000 条'}" Style="{StaticResource TinyText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{StaticResource InputMono}" Width="96" Height="32"
                                         MinHeight="32" Text="{Binding CommandHistoryLimit, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Button Style="{StaticResource BtnSmallDanger}" Content="{loc:Tr '清空全部本地历史'}"
                                    HorizontalAlignment="Left" Command="{Binding ClearAllHistoryCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- 本地数据 -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '本地数据'}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                            <TextBlock Text="{Binding DataDirectory}" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs11}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Tr '连接配置（密码经 DPAPI 加密）、设置与历史均保存在该目录，不会上传到任何外部服务。'}"
                                       Style="{StaticResource TinyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnSmall}" Content="{loc:Tr '打开数据目录'}"
                                            Command="{Binding OpenDataFolderCommand}" />
                                    <Button Style="{StaticResource BtnSmall}" Content="{loc:Tr '导出连接配置'}" Margin="8,0,0,0"
                                            ToolTip="{loc:Tr '导出 JSON 配置，默认不包含密码与 SSH 凭据'}"
                                            Command="{Binding ExportConnectionsCommand}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding AppVersion, StringFormat={loc:Tr '版本 {0}'}}"
                                           Style="{StaticResource TinyText}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 底部保存栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Fs115}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ErrorText}" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,2,0,0"
                               Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVis}, ConverterParameter=invert}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSecondary}" Content="{loc:Tr '恢复默认'}"
                            Command="{Binding ResetDefaultsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource BtnPrimary}" Content="{loc:Tr '保存设置'}" MinWidth="96"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
