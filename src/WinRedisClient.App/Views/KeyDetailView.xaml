<UserControl x:Class="WinRedisClient.App.Views.KeyDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
             xmlns:vm="clr-namespace:WinRedisClient.Presentation.ViewModels;assembly=WinRedisClient.Presentation"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════ 头部 ══════════ -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="18,13,14,11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding KeyName}" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs16}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding KeyName}" />
                        <Border Grid.Column="1" Style="{StaticResource TypeChip}" Margin="9,0,0,0" Padding="7,2"
                                Background="{Binding KeyType, Converter={StaticResource KeyTypeToBrush}}"
                                Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TypeDisplay}" FontSize="{DynamicResource Fs105}" FontWeight="SemiBold"
                                       Foreground="{Binding KeyType, Converter={StaticResource KeyTypeToBrush}, ConverterParameter=fg}" />
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource IconBtnSmall}" Margin="6,0,0,0" Content="&#xE8C8;"
                                Command="{Binding CopyKeyCommand}" ToolTip="{loc:Tr '复制 Key 名称'}"
                                IsEnabled="{Binding HasKey}" AutomationProperties.Name="{loc:Tr '复制 Key 名称'}" />
                        <Button Grid.Column="3" Style="{StaticResource IconBtnSmall}" Content="&#xE72C;"
                                Command="{Binding RefreshCommand}" ToolTip="{loc:Tr '重新读取该 Key'}"
                                IsEnabled="{Binding HasKey}" AutomationProperties.Name="{loc:Tr '重新读取 Key'}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="5" Padding="7,3" Margin="0,0,6,0"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Fs9}"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr '只读'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold" Margin="4,0,0,0"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding HeaderStatus}" FontSize="{DynamicResource Fs105}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,9,0,0" Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0">
                        <Border Style="{StaticResource TagBadge}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TTL" FontSize="{DynamicResource Fs95}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding TtlText}" FontFamily="{StaticResource MonoFont}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TagBadge}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr '大小'}" FontSize="{DynamicResource Fs95}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TagBadge}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr '数量'}" FontSize="{DynamicResource Fs95}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource MonoFont}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TagBadge}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr '编码'}" FontSize="{DynamicResource Fs95}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding EncodingText}" FontFamily="{StaticResource MonoFont}" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '重命名'}"
                                FontSize="{DynamicResource Fs105}" Padding="8,3" Command="{Binding RenameKeyCommand}"
                                ToolTip="{loc:Tr '重命名当前 Key（目标存在时不会覆盖）'}" />
                        <Button Style="{StaticResource BtnSmallGhost}" Content="TTL" Margin="6,0,0,0"
                                FontSize="{DynamicResource Fs105}" Padding="8,3" Command="{Binding SetTtlCommand}"
                                ToolTip="{loc:Tr '设置或清除当前 Key 的过期时间'}" />
                        <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '删除'}" Margin="6,0,0,0"
                                FontSize="{DynamicResource Fs105}" Padding="8,3" Command="{Binding DeleteKeyCommand}"
                                Foreground="{DynamicResource DangerBrush}"
                                ToolTip="{loc:Tr '删除当前 Key（需要确认）'}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════ 内容 ══════════ -->
        <Grid Grid.Row="1">
            <!-- 空状态 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                        Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8D7;" Style="{StaticResource EmptyIcon}" FontSize="{DynamicResource Fs36}" />
                <TextBlock Text="{loc:Tr '选择一个 Key 查看详情'}" Style="{StaticResource EmptyTitle}" FontSize="{DynamicResource Fs15}" />
                <TextBlock Style="{StaticResource EmptyHint}"
                           Text="{loc:Tr '支持 String / Hash / List / Set / ZSet / Stream。字符串可编辑保存（保留原 TTL），集合支持分页浏览与元素级写入。'}" />
            </StackPanel>

            <!-- 加载中 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Tr '正在读取 Key 内容…'}" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- String 编辑器 -->
            <Grid Margin="16,12,16,14" Visibility="{Binding IsString, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ValueInfo}" FontSize="{DynamicResource Fs115}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Tr '未保存'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                            <Border Background="{DynamicResource BgTagBrush}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0"
                                    Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Tr '二进制预览'}" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '自动换行'}" FontSize="{DynamicResource Fs105}"
                                      Margin="0,0,10,0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsWrapEnabled}"
                                      ToolTip="{loc:Tr '默认自动换行；关闭后可用横向滚动条查看超长单行'}" />
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '格式化 JSON'}" Margin="0,0,6,0"
                                    Command="{Binding FormatJsonCommand}"
                                    Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource BtnSmall}" Content="{loc:Tr '还原'}" Margin="0,0,6,0"
                                    Command="{Binding RevertStringCommand}" IsEnabled="{Binding IsDirty}" />
                            <Button Style="{StaticResource BtnPrimary}" Content="{loc:Tr '保存'}" MinHeight="26" Padding="14,3"
                                    FontSize="{DynamicResource Fs12}" Command="{Binding SaveStringCommand}" IsEnabled="{Binding CanSave}"
                                    ToolTip="{loc:Tr '写回 Redis 并保留原 TTL (Ctrl+S)'}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,8">
                        <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="7" Padding="10,7" Margin="0,0,0,5"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Tr '当前连接处于只读模式，编辑器不可写入。'}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="7" Padding="10,7" Margin="0,0,0,5"
                                Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Tr '二进制内容以十六进制预览，不能在编辑器中修改。'}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="7" Padding="10,7"
                                Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Tr '内容超过 256 KB，已截断为只读预览；保存已禁用，避免覆盖未读取部分。'}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <TextBox Grid.Row="1" Margin="0,0,0,8"
                         Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding EditorIsReadOnly}" VerticalAlignment="Stretch"
                         MinHeight="180" FontSize="{DynamicResource Fs125}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource InputMultiline}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWrapEnabled}" Value="False">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EditorStatus}" FontSize="{DynamicResource Fs105}"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding EditorInfo}" FontSize="{DynamicResource Fs105}"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </Grid>

            <!-- 集合浏览器 -->
            <Grid Margin="16,12,16,14" Visibility="{Binding IsCollection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ElementSummary}" FontSize="{DynamicResource Fs115}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr '· 消息内容不可编辑'}" FontSize="{DynamicResource Fs105}" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding IsStream, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource BtnSmall}" Content="{Binding OrderText}" Margin="0,0,6,0"
                                Command="{Binding ToggleElementOrderCommand}"
                                Visibility="{Binding ShowOrderToggle, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource BtnSoft}" Content="{Binding AddButtonText}"
                                Command="{Binding BeginAddElementCommand}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" CornerRadius="7" Padding="10,6" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr '字段 / 索引'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr '值'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Score" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding IsZSet, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="3" Text="{loc:Tr '操作'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedElement}"
                             Style="{StaticResource KeyList}" ItemContainerStyle="{StaticResource KeyRow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ElementRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FieldDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs115}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Field}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource Fs12}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" ToolTip="{Binding Value}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreDisplay}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource Fs115}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.IsZSet, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconBtnSmall}" Width="22" Height="22" FontSize="{DynamicResource Fs10}"
                                                Content="&#xE70F;" ToolTip="{loc:Tr '编辑元素'}"
                                                Command="{Binding DataContext.BeginEditElementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsStream, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <Button Style="{StaticResource IconBtnSmall}" Width="22" Height="22" FontSize="{DynamicResource Fs10}"
                                                Content="&#xE74D;" ToolTip="{loc:Tr '删除元素'}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteElementCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Elements.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource EmptyIcon}" FontSize="{DynamicResource Fs26}" />
                        <TextBlock Text="{loc:Tr '集合为空'}" Style="{StaticResource EmptyTitle}" FontSize="{DynamicResource Fs12}" />
                        <TextBlock Text="{loc:Tr '点击右上角按钮写入第一个元素'}" Style="{StaticResource EmptyHint}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoadingElements, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr '正在加载元素…'}" FontSize="{DynamicResource Fs115}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 元素编辑器 -->
                <Border Grid.Row="3" Style="{StaticResource SubCard}" Margin="0,8,0,0"
                        Visibility="{Binding IsElementEditorOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding ElementEditorTitle}" FontSize="{DynamicResource Fs125}" FontWeight="SemiBold" />
                            <Button Style="{StaticResource IconBtnSmall}" Width="22" Height="22" FontSize="{DynamicResource Fs9}"
                                    HorizontalAlignment="Right" Content="&#xE711;"
                                    Command="{Binding CancelElementEditorCommand}" />
                        </Grid>

                        <StackPanel Visibility="{Binding ShowFieldInput, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding FieldLabel}" FontSize="{DynamicResource Fs105}" Margin="0,0,0,3"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding InputField, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding FieldInputReadOnly}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowValueInput, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ValueLabel}" FontSize="{DynamicResource Fs105}" Margin="0,0,0,3"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource InputMultiline}" MinHeight="60" Height="60" FontSize="{DynamicResource Fs12}"
                                     Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowScoreInput, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="Score" FontSize="{DynamicResource Fs105}" Margin="0,0,0,3"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding InputScore, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="{Binding ElementError}" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding ElementError, Converter={StaticResource EmptyStringToVis}, ConverterParameter=invert}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '取消'}" Margin="0,0,6,0"
                                    Command="{Binding CancelElementEditorCommand}" />
                            <Button Style="{StaticResource BtnSmall}" Content="{loc:Tr '保存元素'}"
                                    Command="{Binding CommitElementCommand}"
                                    IsEnabled="{Binding IsSavingElement, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ElementError}" FontSize="{DynamicResource Fs105}" Foreground="{DynamicResource DangerBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '加载更多'}"
                            Command="{Binding LoadMoreElementsCommand}" IsEnabled="{Binding CanLoadMore}"
                            Visibility="{Binding HasMoreElements, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- 未知/未支持内容 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasKey}" Value="True" />
                                    <Condition Binding="{Binding IsString}" Value="False" />
                                    <Condition Binding="{Binding IsCollection}" Value="False" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource EmptyIcon}" Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Text="{Binding HeaderStatus}" Style="{StaticResource EmptyTitle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
