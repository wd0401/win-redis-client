<UserControl x:Class="WinRedisClient.App.Views.HistoryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
             xmlns:vm="clr-namespace:WinRedisClient.Presentation.ViewModels;assembly=WinRedisClient.Presentation"
             Background="Transparent">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource BgTagBrush}">
                        <TextBlock Text="{Binding RecentEnabledText}" FontSize="{DynamicResource Fs105}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource BgTagBrush}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding CommandsEnabledText}" FontSize="{DynamicResource Fs105}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Fs11}" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ErrorText}" FontSize="{DynamicResource Fs11}" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                           Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVis}, ConverterParameter=invert}" />
                <Button Grid.Column="2" Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '刷新'}"
                        Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource TabModern}">
            <!-- 最近访问 -->
            <TabItem Header="{loc:Tr '最近访问'}" Style="{StaticResource TabModernItem}">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,12,10,6">
                            <TextBlock Text="{loc:Tr '最近访问的 Key'}" Style="{StaticResource CardTitle}" />
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '清空最近访问'}" FontSize="{DynamicResource Fs105}"
                                    HorizontalAlignment="Right" Padding="8,3"
                                    Command="{Binding ClearRecentCommand}" IsEnabled="{Binding HasRecent}" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Recent}" Style="{StaticResource ListClean}"
                                 ItemContainerStyle="{StaticResource KeyRow}" Margin="8,0,8,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentKeyRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="{DynamicResource Fs12}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Key}" />
                                            <TextBlock Text="{Binding ConnectionText}" FontSize="{DynamicResource Fs105}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="{DynamicResource Fs105}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0" />
                                        <Button Grid.Column="2" Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '打开'}"
                                                FontSize="{DynamicResource Fs105}" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenKeyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Style="{StaticResource IconBtnSmall}" Width="24" Height="24"
                                                FontSize="{DynamicResource Fs9}" Content="&#xE74D;" ToolTip="{loc:Tr '从最近访问中移除'}"
                                                Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                    Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="{loc:Tr '暂无最近访问'}" Style="{StaticResource EmptyTitle}" />
                            <TextBlock Text="{loc:Tr '在数据浏览中打开的 Key 会记录在本机；可在设置中关闭记录。'}" Style="{StaticResource EmptyHint}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 命令历史 -->
            <TabItem Header="{loc:Tr '命令历史'}" Style="{StaticResource TabModernItem}">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,12,10,6">
                            <TextBlock Text="{loc:Tr '本机命令历史'}" Style="{StaticResource CardTitle}" />
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '清空命令历史'}" FontSize="{DynamicResource Fs105}"
                                    HorizontalAlignment="Right" Padding="8,3"
                                    Command="{Binding ClearCommandsCommand}" IsEnabled="{Binding HasCommands}" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Commands}" Style="{StaticResource ListClean}"
                                 ItemContainerStyle="{StaticResource KeyRow}" Margin="8,0,8,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommandHistoryRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CommandPreview}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="{DynamicResource Fs115}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Command}" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="{DynamicResource Fs105}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '填入终端'}"
                                                FontSize="{DynamicResource Fs105}" Padding="8,3" Margin="10,0,4,0"
                                                Command="{Binding DataContext.UseCommandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '复制'}"
                                                FontSize="{DynamicResource Fs105}" Padding="8,3" Margin="0,0,4,0"
                                                Command="{Binding DataContext.CopyCommandTextCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="3" Style="{StaticResource IconBtnSmall}" Width="24" Height="24"
                                                FontSize="{DynamicResource Fs9}" Content="&#xE74D;" ToolTip="{loc:Tr '删除这条历史'}"
                                                Command="{Binding DataContext.RemoveCommandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                    Visibility="{Binding HasCommands, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="{loc:Tr '暂无命令历史'}" Style="{StaticResource EmptyTitle}" />
                            <TextBlock Text="{loc:Tr '在命令终端执行的非敏感命令会记录在本机；认证类命令永不记录。'}" Style="{StaticResource EmptyHint}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
