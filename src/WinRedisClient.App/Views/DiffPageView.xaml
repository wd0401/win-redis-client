<UserControl x:Class="WinRedisClient.App.Views.DiffPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
             xmlns:vm="clr-namespace:WinRedisClient.Presentation.ViewModels;assembly=WinRedisClient.Presentation"
             Background="Transparent">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 比较设置 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧 -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{DynamicResource InfoLightBrush}" CornerRadius="5" Padding="7,2">
                            <TextBlock Text="{loc:Tr '左侧'}" FontSize="{DynamicResource Fs105}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoBrush}" />
                        </Border>
                        <TextBlock Text="{loc:Tr '只读会话'}" FontSize="{DynamicResource Fs105}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource ComboModern}" Height="34" MinHeight="34"
                                  ItemsSource="{Binding Connections}" SelectedItem="{Binding LeftConnection}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1" Style="{StaticResource ComboModern}" Height="34" MinHeight="34"
                                  Margin="8,0,0,0" ItemsSource="{Binding Databases}" SelectedItem="{Binding LeftDatabase}" />
                    </Grid>
                    <TextBox Style="{StaticResource InputMono}" Height="34" MinHeight="34" Margin="0,8,0,0"
                             Text="{Binding LeftKey, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Tr '要比较的 Key 名称'}" />
                </StackPanel>

                <!-- 交换 -->
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="38" Height="38"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                        Content="&#xE8AB;" FontSize="{DynamicResource Fs14}" ToolTip="{loc:Tr '交换左右'}"
                        Command="{Binding SwapCommand}" />

                <!-- 右侧 -->
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="5" Padding="7,2">
                            <TextBlock Text="{loc:Tr '右侧'}" FontSize="{DynamicResource Fs105}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryDeepBrush}" />
                        </Border>
                        <TextBlock Text="{loc:Tr '只读会话'}" FontSize="{DynamicResource Fs105}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource ComboModern}" Height="34" MinHeight="34"
                                  ItemsSource="{Binding Connections}" SelectedItem="{Binding RightConnection}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1" Style="{StaticResource ComboModern}" Height="34" MinHeight="34"
                                  Margin="8,0,0,0" ItemsSource="{Binding Databases}" SelectedItem="{Binding RightDatabase}" />
                    </Grid>
                    <TextBox Style="{StaticResource InputMono}" Height="34" MinHeight="34" Margin="0,8,0,0"
                             Text="{Binding RightKey, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Tr '要比较的 Key 名称'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource BtnPrimary}" Content="{loc:Tr '开始比较'}" Command="{Binding CompareCommand}"
                    IsEnabled="{Binding CanCompare}" MinWidth="104" />
            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '清除结果'}"
                    Command="{Binding ClearCommand}" Margin="8,0,0,0" IsEnabled="{Binding HasResult}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Fs115}" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ErrorText}" FontSize="{DynamicResource Fs115}" Foreground="{DynamicResource DangerBrush}"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVis}, ConverterParameter=invert}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '复制结果'}" Command="{Binding CopyResultCommand}"
                        IsEnabled="{Binding HasResult}" Margin="0,0,6,0" />
                <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '导出 TXT'}" Command="{Binding ExportCommand}"
                        IsEnabled="{Binding HasResult}" />
            </StackPanel>
        </Grid>

        <!-- 结果 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 元信息 -->
                <Grid Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr '左侧 Key'}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LeftMeta}" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs11}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LeftValuePreview}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource TagBadge}" Background="{DynamicResource BgTagBrush}"
                            VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource Fs105}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{loc:Tr '右侧 Key'}" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RightMeta}" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs11}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                                   ToolTip="{Binding RightValuePreview}" />
                    </StackPanel>
                </Grid>

                <!-- 差异统计 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource SuccessBrush}" Opacity="0.9"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding AddedCount, StringFormat=+{0}}" FontSize="{DynamicResource Fs10}" Foreground="White" />
                    </Border>
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource DangerBrush}" Opacity="0.9"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding RemovedCount, StringFormat=−{0}}" FontSize="{DynamicResource Fs10}" Foreground="White" />
                    </Border>
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource WarningBrush}"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding ModifiedCount, StringFormat=~{0}}" FontSize="{DynamicResource Fs10}" Foreground="White" />
                    </Border>
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource DangerLightBrush}"
                            Visibility="{Binding TypeMismatch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr '类型不同'}" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                    <Border Style="{StaticResource TagBadge}" Background="{DynamicResource WarningLightBrush}"
                            Margin="6,0,0,0" Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr '内容已截断'}" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource HSep}" Margin="16,0,16,6" />

                <!-- 差异行 -->
                <ListBox Grid.Row="3" ItemsSource="{Binding Lines}" Style="{StaticResource ListClean}"
                         ItemContainerStyle="{StaticResource KeyRow}" Margin="8,0,8,8"
                         Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiffLineRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Prefix}" FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs12}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding KindName, Converter={StaticResource DiffKindToBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="{DynamicResource Fs115}" TextWrapping="Wrap"
                                           Foreground="{Binding KindName, Converter={StaticResource DiffKindToBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" VerticalAlignment="Center"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE8A9;" Style="{StaticResource EmptyIcon}" />
                    <TextBlock Text="{loc:Tr '尚未比较'}" Style="{StaticResource EmptyTitle}" />
                    <TextBlock Text="{loc:Tr '选择左右连接与 Key 后点击“开始比较”。两个会话均以只读方式建立，不会修改任何数据。'}"
                               Style="{StaticResource EmptyHint}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
