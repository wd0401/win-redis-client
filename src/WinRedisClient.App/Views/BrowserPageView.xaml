<UserControl x:Class="WinRedisClient.App.Views.BrowserPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
             xmlns:vm="clr-namespace:WinRedisClient.Presentation.ViewModels;assembly=WinRedisClient.Presentation"
             xmlns:views="clr-namespace:WinRedisClient.App.Views"
             Background="Transparent">
    <Grid Margin="16,10,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════ 当前连接栏 ══════════ -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="2,2,2,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToBrush}, ConverterParameter=ConnectedBrush|DisconnectedBrush}" />
                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fs18}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding DataContext.ActiveConnectionName, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextTrimming="CharacterEllipsis" MaxWidth="240"
                           ToolTip="{Binding DataContext.ActiveConnectionName, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fs115}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding DataContext.ActiveConnectionEndpoint, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextTrimming="CharacterEllipsis" MaxWidth="230"
                           ToolTip="{Binding DataContext.ActiveConnectionEndpoint, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Grid.Column="3" Style="{StaticResource IconBtnSmall}" Width="26" Height="26" Margin="4,0,0,0"
                        Content="&#xE8C8;" ToolTip="{loc:Tr '复制连接地址'}" AutomationProperties.Name="{loc:Tr '复制连接地址'}"
                        Command="{Binding DataContext.CopyEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                <ComboBox Grid.Column="4" Style="{StaticResource ComboModern}" Width="150" Height="30" MinHeight="30"
                          MaxDropDownHeight="560" Margin="12,0,0,0" FontSize="{DynamicResource Fs115}"
                          ItemsSource="{Binding DataContext.DatabaseEntries, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValuePath="Number"
                          SelectedValue="{Binding DataContext.DatabaseIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}"
                          DropDownOpened="OnDatabaseDropDownOpened"
                          ToolTip="{loc:Tr '切换当前数据库；展开时读取各 DB 的 Key 数量'}"
                          AutomationProperties.Name="{loc:Tr '数据库'}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DatabaseEntryViewModel}">
                            <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Fs115}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource DangerLightBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,6,0"
                            Visibility="{Binding DataContext.IsProduction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Fs9}"
                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr '生产环境'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold" Margin="4,0,0,0"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,6,0"
                            Visibility="{Binding DataContext.IsReadOnlyConnection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Fs9}"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Tr '只读'}" FontSize="{DynamicResource Fs10}" FontWeight="SemiBold" Margin="4,0,0,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToBrush}, ConverterParameter=ConnectedBrush|DisconnectedBrush}" />
                    <TextBlock FontSize="{DynamicResource Fs115}" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:Tr '未连接'}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Text" Value="{loc:Tr '已连接'}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Width="1" Height="14" Margin="10,0" Background="{DynamicResource BorderLightBrush}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr '延迟'}" FontSize="{DynamicResource Fs115}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Margin="5,0,0,0" FontSize="{DynamicResource Fs115}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding DataContext.ActiveConnection.LatencyText, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=—, FallbackValue=—}" />
                    </StackPanel>
                    <Border Width="1" Height="14" Margin="10,0" Background="{DynamicResource BorderLightBrush}" />
                    <Button Style="{StaticResource IconBtn}" Width="30" Height="30" Content="&#xE72C;"
                            Command="{Binding DataContext.RefreshCurrentPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{loc:Tr '刷新 Key 列表 (F5)'}" AutomationProperties.Name="{loc:Tr '刷新 Key 列表'}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.35*" MinWidth="300" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="0.65*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- ══════════ Key 列表 ══════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,14,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding Browser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" FontSize="{DynamicResource Fs12}" KeyDown="OnSearchKeyDown" />
                        <TextBlock Text="{loc:Tr '搜索 Key…'}" FontSize="{DynamicResource Fs12}" Margin="33,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding Browser.SearchText, Converter={StaticResource EmptyStringToVis}}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Fs11}"
                                   Margin="11,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False" />
                        <Button Style="{StaticResource IconBtnSmall}" Width="22" Height="22" FontSize="{DynamicResource Fs9}"
                                HorizontalAlignment="Right" Margin="0,0,4,0" Content="&#xE711;"
                                Command="{Binding Browser.ClearSearchCommand}" ToolTip="{loc:Tr '清空搜索'}" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="6,0,0,0"
                            Content="&#xE710;" Command="{Binding Browser.AddKeyCommand}" ToolTip="{loc:Tr '新建 Key'}" />
                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="2,0,0,0"
                            Content="&#xE72C;" Command="{Binding Browser.RefreshCommand}" ToolTip="{loc:Tr '重新扫描 (F5)'}" />
                </Grid>

                <WrapPanel Grid.Row="1" Margin="14,0,12,8">
                    <ComboBox Style="{StaticResource ComboModern}" Height="30" MinHeight="30" FontSize="{DynamicResource Fs12}"
                              Width="102" ItemsSource="{Binding Browser.SearchModes}" SelectedItem="{Binding Browser.SearchMode}"
                              ToolTip="{loc:Tr '模糊匹配：仅过滤已加载的 Key；全匹配：按名称精确查询；数据库模糊：用 SCAN 扫描全库（会先弹出性能确认）'}" />
                    <ComboBox Style="{StaticResource ComboModern}" Height="30" MinHeight="30" FontSize="{DynamicResource Fs12}"
                              Width="78" Margin="6,0,0,0" ItemsSource="{Binding Browser.TypeFilters}" SelectedItem="{Binding Browser.TypeFilter}"
                              ToolTip="{loc:Tr '按 Key 类型筛选'}" />
                    <ComboBox Style="{StaticResource ComboModern}" Height="30" MinHeight="30" FontSize="{DynamicResource Fs12}"
                              Width="88" Margin="6,0,0,0" ItemsSource="{Binding Browser.TtlFilters}" SelectedItem="{Binding Browser.TtlFilter}"
                              ToolTip="{loc:Tr '按过期状态筛选'}" />
                    <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '目录'}" FontSize="{DynamicResource Fs115}"
                              Margin="8,0,0,0" IsChecked="{Binding Browser.IsTreeView}" ToolTip="{loc:Tr '按分隔符聚合为虚拟目录（不会修改 Redis）'}"
                              VerticalAlignment="Center" />
                </WrapPanel>

                <Grid Grid.Row="2">
                    <!-- 列表视图 -->
                    <ListBox ItemsSource="{Binding Browser.VisibleKeys}" SelectedItem="{Binding Browser.SelectedKey}"
                             Style="{StaticResource KeyList}" ItemContainerStyle="{StaticResource KeyRow}"
                             Visibility="{Binding Browser.IsTreeView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeyItemViewModel}">
                                <Border Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr '复制 Key 名称'}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.CopyKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{loc:Tr '重命名…'}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.RenameKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{loc:Tr '设置 TTL…'}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.SetTtlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Tr '删除 Key'}"
                                                      Foreground="{DynamicResource DangerBrush}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.DeleteKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TypeChip}" VerticalAlignment="Center"
                                                Background="{Binding Type, Converter={StaticResource KeyTypeToBrush}}">
                                            <TextBlock Text="{Binding TypeShort}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{Binding Type, Converter={StaticResource KeyTypeToBrush}, ConverterParameter=fg}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="{DynamicResource Fs12}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource Fs105}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0"
                                                       Visibility="{Binding DataContext.ShowKeySize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding TtlText}" FontSize="{DynamicResource Fs105}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 目录视图 -->
                    <TreeView x:Name="KeyTree" ItemsSource="{Binding Browser.TreeRoots}" Style="{StaticResource KeyTree}"
                              ItemContainerStyle="{StaticResource KeyTreeItem}"
                              SelectedItemChanged="OnTreeSelectedItemChanged"
                              Visibility="{Binding Browser.IsTreeView, Converter={StaticResource BoolToVis}}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:KeyTreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                      AutomationProperties.Name="{Binding Name}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr '复制 Key 名称'}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.CopyKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Key, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBool}}" />
                                            <MenuItem Header="{loc:Tr '重命名…'}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.RenameKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Key, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBool}}" />
                                            <MenuItem Header="{loc:Tr '设置 TTL…'}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.SetTtlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Key, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBool}}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Tr '删除 Key'}"
                                                      Foreground="{DynamicResource DangerBrush}"
                                                      Command="{Binding PlacementTarget.Tag.Browser.DeleteKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Key, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBool}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                               Margin="0,0,5,0"
                                               Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />
                                    <Border Style="{StaticResource TypeChip}" Margin="0,0,6,0"
                                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                            Background="{Binding Key.Type, Converter={StaticResource KeyTypeToBrush}}">
                                        <TextBlock Text="{Binding TypeShort}" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{Binding Key.Type, Converter={StaticResource KeyTypeToBrush}, ConverterParameter=fg}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="{DynamicResource Fs12}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="{DynamicResource Fs10}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- 空状态 -->
                    <StackPanel VerticalAlignment="Center" Margin="28,0"
                                Visibility="{Binding Browser.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="{loc:Tr '没有可显示的 Key'}" Style="{StaticResource EmptyTitle}" />
                        <TextBlock Text="{loc:Tr '连接 Redis 后使用 SCAN 浏览；搜索会自动防抖并过滤结果。'}" Style="{StaticResource EmptyHint}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Browser.ScanStatus}" FontSize="{DynamicResource Fs105}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Browser.ErrorText}" FontSize="{DynamicResource Fs105}"
                                       Foreground="{DynamicResource DangerBrush}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Browser.ErrorText, Converter={StaticResource EmptyStringToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '取消'}" FontSize="{DynamicResource Fs105}"
                                    Command="{Binding Browser.CancelScanCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding Browser.IsScanning, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource BtnSmallGhost}" Content="{loc:Tr '加载下一批'}" FontSize="{DynamicResource Fs105}"
                                    Command="{Binding Browser.LoadMoreCommand}"
                                    IsEnabled="{Binding Browser.IsScanning, Converter={StaticResource InverseBool}}"
                                    ToolTip="{loc:Tr '按 SCAN 游标继续加载一批（约 500 个 Key）'}"
                                    Visibility="{Binding Browser.HasMore, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"
                      Cursor="SizeWE" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

        <!-- ══════════ Key 详情 ══════════ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <views:KeyDetailView DataContext="{Binding Detail}" />
        </Border>
        </Grid>
    </Grid>
</UserControl>
