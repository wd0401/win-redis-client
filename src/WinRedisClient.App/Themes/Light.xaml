<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 亮色主题（PRD 设计令牌） ═══ -->

    <!-- 品牌色 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#625BFF" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5145E5" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#E0E7FF" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#4338CA" />

    <!-- 背景 -->
    <SolidColorBrush x:Key="BgAppBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSidebarHoverBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="BgSidebarActiveBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="BgInputBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="BgTagBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BgTerminalBrush" Color="#111827" />
    <SolidColorBrush x:Key="BgToolbarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgStatusBarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgOverlayBrush" Color="#80172033" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSidebarBrush" Color="#334155" />
    <SolidColorBrush x:Key="TextSidebarDimBrush" Color="#94A3B8" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderLightBrush" Color="#E3E8F2" />
    <SolidColorBrush x:Key="BorderLighterBrush" Color="#F0F3F9" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#625BFF" />

    <!-- 环境色 -->
    <SolidColorBrush x:Key="EnvDevBrush" Color="#10B981" />
    <SolidColorBrush x:Key="EnvTestBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="EnvStagingBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="EnvProdBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="EnvProdBgBrush" Color="#FEF2F2" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="InfoLightBrush" Color="#EFF6FF" />

    <!-- Key 类型色 -->
    <SolidColorBrush x:Key="TypeStringBg" Color="#EDE9FE" />
    <SolidColorBrush x:Key="TypeStringFg" Color="#7C3AED" />
    <SolidColorBrush x:Key="TypeHashBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="TypeHashFg" Color="#D97706" />
    <SolidColorBrush x:Key="TypeListBg" Color="#DBEAFE" />
    <SolidColorBrush x:Key="TypeListFg" Color="#2563EB" />
    <SolidColorBrush x:Key="TypeSetBg" Color="#D1FAE5" />
    <SolidColorBrush x:Key="TypeSetFg" Color="#059669" />
    <SolidColorBrush x:Key="TypeZsetBg" Color="#FCE7F3" />
    <SolidColorBrush x:Key="TypeZsetFg" Color="#DB2777" />
    <SolidColorBrush x:Key="TypeStreamBg" Color="#CFFAFE" />
    <SolidColorBrush x:Key="TypeStreamFg" Color="#0891B2" />
    <SolidColorBrush x:Key="TypeDefaultBg" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TypeDefaultFg" Color="#64748B" />

    <!-- 强调色上的文字（始终白色） -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

</ResourceDictionary>
