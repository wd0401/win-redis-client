<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 森林主题（低饱和浅色：豆绿 + 森林绿） ═══ -->

    <!-- 品牌色 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3F7B52" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#336744" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EDF6EF" />
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#D8EBDD" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#2D5A3A" />

    <!-- 背景 -->
    <SolidColorBrush x:Key="BgAppBrush" Color="#F5F9F2" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#FCFEFA" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#E6EEE3" />
    <SolidColorBrush x:Key="BgSidebarHoverBrush" Color="#DCE7D8" />
    <SolidColorBrush x:Key="BgSidebarActiveBrush" Color="#CFDECD" />
    <SolidColorBrush x:Key="BgInputBrush" Color="#EFF5EC" />
    <SolidColorBrush x:Key="BgTagBrush" Color="#E0EBDD" />
    <SolidColorBrush x:Key="BgTerminalBrush" Color="#142019" />
    <SolidColorBrush x:Key="BgToolbarBrush" Color="#F8FBF5" />
    <SolidColorBrush x:Key="BgStatusBarBrush" Color="#F8FBF5" />
    <SolidColorBrush x:Key="BgOverlayBrush" Color="#801A2B20" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2A20" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6E5F" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A9B8C" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#F5F9F2" />
    <SolidColorBrush x:Key="TextSidebarBrush" Color="#334A38" />
    <SolidColorBrush x:Key="TextSidebarDimBrush" Color="#7F9284" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderLightBrush" Color="#D6E3D7" />
    <SolidColorBrush x:Key="BorderLighterBrush" Color="#EAF2EA" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B8CCBB" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#3F7B52" />

    <!-- 环境色 -->
    <SolidColorBrush x:Key="EnvDevBrush" Color="#10B981" />
    <SolidColorBrush x:Key="EnvTestBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="EnvStagingBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="EnvProdBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="EnvProdBgBrush" Color="#FEF2F2" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="ConnectedBrush" Color="#10B981" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#B8CCBB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="InfoLightBrush" Color="#EFF6FF" />

    <!-- Key 类型色 -->
    <SolidColorBrush x:Key="TypeStringBg" Color="#EDE9FE" />
    <SolidColorBrush x:Key="TypeStringFg" Color="#7C3AED" />
    <SolidColorBrush x:Key="TypeHashBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="TypeHashFg" Color="#D97706" />
    <SolidColorBrush x:Key="TypeListBg" Color="#DBEAFE" />
    <SolidColorBrush x:Key="TypeListFg" Color="#2563EB" />
    <SolidColorBrush x:Key="TypeSetBg" Color="#D1FAE5" />
    <SolidColorBrush x:Key="TypeSetFg" Color="#059669" />
    <SolidColorBrush x:Key="TypeZsetBg" Color="#FCE7F3" />
    <SolidColorBrush x:Key="TypeZsetFg" Color="#DB2777" />
    <SolidColorBrush x:Key="TypeStreamBg" Color="#CFFAFE" />
    <SolidColorBrush x:Key="TypeStreamFg" Color="#0891B2" />
    <SolidColorBrush x:Key="TypeDefaultBg" Color="#E0EBDD" />
    <SolidColorBrush x:Key="TypeDefaultFg" Color="#5B6E5F" />

    <!-- 强调色上的文字（始终白色） -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

</ResourceDictionary>
