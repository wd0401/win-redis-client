<Window x:Class="WinRedisClient.App.Dialogs.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
        Title="{loc:Tr '确认操作'}" Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Fs13}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="14" Margin="14" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Padding="22,18,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBubble" Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource DangerLightBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                                   FontSize="{DynamicResource Fs16}" Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{loc:Tr '确认操作'}" FontSize="{DynamicResource Fs16}" FontWeight="SemiBold"
                               Margin="12,6,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,8,24,0" TextWrapping="Wrap"
                       LineHeight="21" FontSize="{DynamicResource Fs125}" Foreground="{DynamicResource TextSecondaryBrush}" />

            <StackPanel x:Name="RequiredPanel" Grid.Row="2" Margin="24,14,24,0" Visibility="Collapsed">
                <TextBlock x:Name="RequiredHint" Text="{loc:Tr '请输入 Key 名称以确认：'}" FontSize="{DynamicResource Fs115}"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="RequiredInput" Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                         TextChanged="OnRequiredTextChanged" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="22,18,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Tr '此操作不可自动撤销'}" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '取消'}"
                        MinWidth="86" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" Grid.Column="2" Style="{StaticResource BtnDanger}" Content="{loc:Tr '确认'}"
                        MinWidth="110" IsDefault="True" Click="OnConfirmClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
