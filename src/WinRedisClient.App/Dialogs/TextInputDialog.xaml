<Window x:Class="WinRedisClient.App.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
        Title="{loc:Tr '输入'}" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Fs13}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="14" Margin="14" Effect="{StaticResource CardShadow}">
        <StackPanel>
            <Border Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Padding="22,18,18,4">
                <TextBlock x:Name="TitleText" Text="{loc:Tr '重命名'}" FontSize="{DynamicResource Fs16}" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="HintText" Margin="24,4,24,0" FontSize="{DynamicResource Fs12}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="ValueInput" Style="{StaticResource InputDefault}" Margin="24,12,24,0"
                     FontFamily="{StaticResource MonoFont}" TextChanged="OnValueChanged" />
            <TextBlock x:Name="ErrorText" Margin="24,6,24,0" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"
                       Visibility="Collapsed" />
            <Grid Margin="22,18,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '取消'}" IsCancel="True"
                        MinWidth="86" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button x:Name="OkButton" Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="{loc:Tr '确定'}"
                        MinWidth="96" IsDefault="True" Click="OnOkClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
