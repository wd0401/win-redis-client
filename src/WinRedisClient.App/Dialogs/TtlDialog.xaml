<Window x:Class="WinRedisClient.App.Dialogs.TtlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
        Title="{loc:Tr '修改 TTL'}" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Fs13}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="14" Margin="14" Effect="{StaticResource CardShadow}">
        <StackPanel>
            <Border Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Padding="22,18,18,4">
                <TextBlock Text="{loc:Tr '修改过期时间'}" FontSize="{DynamicResource Fs16}" FontWeight="SemiBold" />
            </Border>
            <TextBlock Margin="24,4,24,0" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="{loc:Tr '为 Key 设置新的 TTL；选择“永不过期”将移除过期时间。'}" />
            <TextBlock x:Name="CurrentTtlText" Margin="24,8,24,0" FontSize="{DynamicResource Fs11}"
                       FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextTertiaryBrush}" />

            <StackPanel Margin="24,14,24,0">
                <TextBlock Text="{loc:Tr '过期时间'}" Style="{StaticResource SectionLabel}" />
                <ComboBox x:Name="PresetCombo" Style="{StaticResource ComboModern}"
                          SelectionChanged="OnPresetChanged">
                    <ComboBoxItem Content="{loc:Tr '永不过期'}" />
                    <ComboBoxItem Content="{loc:Tr '60 秒'}" />
                    <ComboBoxItem Content="{loc:Tr '5 分钟'}" />
                    <ComboBoxItem Content="{loc:Tr '1 小时'}" />
                    <ComboBoxItem Content="{loc:Tr '1 天'}" />
                    <ComboBoxItem Content="{loc:Tr '7 天'}" />
                    <ComboBoxItem Content="{loc:Tr '自定义…'}" />
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="CustomPanel" Margin="24,12,24,0" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr '自定义秒数'}" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="CustomInput" Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Margin="24,8,24,0" FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"
                       Visibility="Collapsed" />

            <Grid Margin="22,18,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '取消'}" IsCancel="True"
                        MinWidth="86" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="{loc:Tr '应用 TTL'}" MinWidth="104"
                        IsDefault="True" Click="OnApplyClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
