<Window x:Class="WinRedisClient.App.Dialogs.CloseConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
        Title="{loc:Tr '关闭 WinRedis'}" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Fs13}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="14" Margin="14" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" Padding="22,18,16,8" MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource PrimarySubtleBrush}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}"
                                   FontSize="{DynamicResource Fs16}" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{loc:Tr '关闭 WinRedis'}"
                               FontSize="{DynamicResource Fs16}" FontWeight="SemiBold"
                               Margin="12,6,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Margin="24,8,24,0" TextWrapping="Wrap" LineHeight="21"
                       FontSize="{DynamicResource Fs125}" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Tr '最小化到系统托盘后 WinRedis 继续在后台运行，可随时从托盘图标恢复窗口；也可以直接退出。'}" />

            <CheckBox x:Name="RememberCheck" Grid.Row="2" Margin="24,14,24,0" Style="{StaticResource CheckBoxModern}"
                      Content="{loc:Tr '记住我的选择（可在设置中修改）'}" FontSize="{DynamicResource Fs115}" />

            <Grid Grid.Row="3" Margin="22,18,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '取消'}"
                        MinWidth="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
                <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '直接退出'}"
                        MinWidth="92" Margin="0,0,8,0" Click="OnExitClick" />
                <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="{loc:Tr '最小化到托盘'}"
                        MinWidth="118" IsDefault="True" Click="OnMinimizeClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
