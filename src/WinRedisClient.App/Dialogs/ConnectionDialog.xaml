<Window x:Class="WinRedisClient.App.Dialogs.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
        Title="{loc:Tr '连接'}" Width="780" Height="800" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Fs13}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="14" Margin="14" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Padding="24,20,14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Fs17}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionKindNote}" FontSize="{DynamicResource Fs115}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE711;" Click="OnCloseClick" />
                </Grid>
            </Border>

            <!-- 表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,18,4">
                <StackPanel>
                    <Border Style="{StaticResource SubCard}" Padding="16" Margin="0,0,8,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '基本信息'}" Style="{StaticResource SectionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Tr '连接名称'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="60" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Tr '环境'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Style="{StaticResource ComboModern}"
                                              ItemsSource="{Binding EnvironmentOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding Environment}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Visibility="{Binding IsCustomEnvironment, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr '环境名称'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding EnvironmentLabel, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="20" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Tr '分组（可选）'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputDefault}"
                                                 Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="40"
                                                 ToolTip="{loc:Tr '相同分组名的连接会在左侧列表中归为一组；留空显示在“未分组”'}" />
                                        <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" MinWidth="36"
                                                Margin="6,0,0,0" Padding="8,0" FontFamily="{StaticResource IconFont}"
                                                Content="&#xE70D;" Click="OnGroupPickClick"
                                                ToolTip="{loc:Tr '从已有分组或常用分组（生产/预发/测试/开发）中快速选择'}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Tr '警告色'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Style="{StaticResource ComboModern}"
                                              ItemsSource="{Binding WarningColorOptions}"
                                              SelectedValuePath="Value" SelectedValue="{Binding WarningColor}"
                                              ToolTip="{loc:Tr '在左侧连接卡片上显示颜色标记，仅用于本地提醒'}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                             Fill="{Binding Hex, Converter={StaticResource StringToBrush}}" />
                                                    <TextBlock Text="{Binding Display}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{loc:Tr '分组影响左侧列表；警告色只是本地视觉标记，不会修改 Redis'}"
                                           FontSize="{DynamicResource Fs105}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubCard}" Padding="16" Margin="0,0,8,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr '服务地址与认证'}" Style="{StaticResource SectionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Tr '默认 DB'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Style="{StaticResource ComboModern}" ItemsSource="{Binding DatabaseOptions}"
                                              SelectedItem="{Binding Database}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Tr '用户名（ACL，可选）'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Tr '密码'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}"
                                                 PasswordChanged="OnPasswordChanged" />
                                    <TextBlock Text="{loc:Tr '已保存密码，留空表示保持不变'}" FontSize="{DynamicResource Fs105}" Margin="2,4,0,0"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding HasStoredPassword, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '清除已保存密码'}" FontSize="{DynamicResource Fs11}"
                                              Margin="0,6,0,0" IsChecked="{Binding ClearStoredPassword}"
                                              Checked="OnClearStoredPasswordChecked"
                                              Visibility="{Binding HasStoredPassword, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '启用 TLS（SSL）加密连接'}" Margin="0,14,0,0"
                                      IsChecked="{Binding UseTls}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubCard}" Padding="16" Margin="0,0,8,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Tr '超时与备注'}" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{loc:Tr '超时单位为秒'}" FontSize="{DynamicResource Fs105}" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Tr '连接超时'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding ConnectTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Tr '命令超时'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding CommandTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Tr '备注'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="200" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '只读连接（禁止任何写操作）'}" Margin="0,14,0,0"
                                      IsChecked="{Binding IsReadOnly}" />
                            <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '连接后自动批量加载 Key（默认开启）'}" Margin="0,10,0,0"
                                      IsChecked="{Binding AutoLoadKeys}"
                                      ToolTip="{loc:Tr '按 SCAN 分批加载并限制首批数量，避免大 Key 库一次性拉取造成卡顿'}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubCard}" Padding="16" Margin="0,0,8,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Tr 'SSH 隧道'}" Style="{StaticResource SectionLabel}" />
                                <ToggleButton Style="{StaticResource SwitchToggle}" Content="{loc:Tr '通过跳板机连接'}"
                                              HorizontalAlignment="Right" IsChecked="{Binding UseSshTunnel, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,4,0,0" Visibility="{Binding ShowSshFields, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SSH Host" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                                             Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SSH Port" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}"
                                             Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Tr 'SSH 用户名'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Style="{StaticResource InputDefault}" Text="{Binding SshUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0" Visibility="{Binding ShowSshFields, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Tr 'SSH 认证方式'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Style="{StaticResource ComboModern}" ItemsSource="{Binding SshAuthOptions}"
                                              SelectedItem="{Binding SshAuthModeText}"
                                              ToolTip="{loc:Tr '密码：用户名 + 密码登录；私钥文件：从本机选择 OpenSSH/PEM 私钥（不支持 .ppk）'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{loc:Tr '目标地址保持不变：连接会先建立 SSH 隧道，再访问上方 Host:Port'}"
                                           FontSize="{DynamicResource Fs105}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowSshFields, Converter={StaticResource BoolToVis}}">
                                <StackPanel Visibility="{Binding UseSshPassword, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr 'SSH 密码'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <PasswordBox x:Name="SshPasswordBox" Style="{StaticResource PasswordInput}"
                                                 PasswordChanged="OnSshPasswordChanged" />
                                    <TextBlock Text="{loc:Tr '已保存 SSH 密码，留空表示保持不变'}" FontSize="{DynamicResource Fs105}" Margin="2,4,0,0"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding HasStoredSshPassword, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '清除已保存 SSH 密码'}" FontSize="{DynamicResource Fs11}"
                                              Margin="0,6,0,0" IsChecked="{Binding ClearStoredSshPassword}"
                                              Checked="OnClearStoredSshPasswordChecked"
                                              Visibility="{Binding HasStoredSshPassword, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding UseSshKey, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr 'SSH 私钥文件'}" FontSize="{DynamicResource Fs11}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SshKeyPathBox" Style="{StaticResource InputMono}"
                                                 Text="{Binding SshPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '浏览…'}"
                                                Margin="8,0,0,0" Click="OnBrowseSshKeyClick" />
                                    </Grid>
                                    <TextBlock Text="{loc:Tr '支持 OpenSSH / PEM 私钥（.pem、id_rsa、id_ed25519 等）；不支持 PuTTY .ppk'}"
                                               FontSize="{DynamicResource Fs105}" Margin="2,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{loc:Tr '私钥口令（可选）'}" FontSize="{DynamicResource Fs11}" Margin="0,12,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <PasswordBox x:Name="SshKeyPassphraseBox" Style="{StaticResource PasswordInput}"
                                                 PasswordChanged="OnSshKeyPassphraseChanged" />
                                    <TextBlock Text="{loc:Tr '已保存私钥口令，留空表示保持不变'}" FontSize="{DynamicResource Fs105}" Margin="2,4,0,0"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding HasStoredKeyPassphrase, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox Style="{StaticResource CheckBoxModern}" Content="{loc:Tr '清除已保存私钥口令'}" FontSize="{DynamicResource Fs11}"
                                              Margin="0,6,0,0" IsChecked="{Binding ClearStoredKeyPassphrase}"
                                              Checked="OnClearStoredKeyPassphraseChecked"
                                              Visibility="{Binding HasStoredKeyPassphrase, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 测试连接（固定在底部，避免长表单下滑后才能测试） -->
            <Border Grid.Row="2" Background="{DynamicResource BgInputBrush}" CornerRadius="10" Padding="12,10"
                    Margin="24,4,24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding TestStatus}" FontSize="{DynamicResource Fs115}" TextWrapping="Wrap"
                                   Foreground="{Binding TestSucceeded, Converter={StaticResource BoolToBrush}, ConverterParameter=SuccessBrush|DangerBrush}" />
                        <TextBlock Text="{Binding ErrorText}" FontSize="{DynamicResource Fs11}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '测试连接'}"
                            Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- 底部 -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0"
                    Padding="22,14" Background="{DynamicResource BgCardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr '密码与私钥口令使用 Windows DPAPI 加密后保存在本机'}" FontSize="{DynamicResource Fs105}"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '取消'}" MinWidth="88"
                            IsCancel="True" Margin="0,0,8,0" Click="OnCloseClick" />
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="{loc:Tr '保存连接'}" MinWidth="110"
                            IsDefault="True" Click="OnSaveClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
