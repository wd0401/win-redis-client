<Window x:Class="WinRedisClient.App.Dialogs.CreateKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WinRedisClient.App.Localization"
        Title="{loc:Tr '新建 Key'}" Width="560" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="{DynamicResource Fs13}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="14" Margin="14" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Padding="24,20,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr '新建 Key'}" FontSize="{DynamicResource Fs17}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ContextText" FontSize="{DynamicResource Fs115}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE711;" Click="OnCloseClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,18,4">
                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Key 名称'}" Style="{StaticResource SectionLabel}" />
                    <TextBox x:Name="NameInput" Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr '类型'}" Style="{StaticResource SectionLabel}" />
                            <ComboBox x:Name="TypeCombo" Style="{StaticResource ComboModern}"
                                      SelectionChanged="OnTypeChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr 'TTL（秒）'}" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="TtlInput" Style="{StaticResource InputDefault}"
                                     FontFamily="{StaticResource MonoFont}" Text="0" />
                            <TextBlock Text="{loc:Tr '0 或留空表示永不过期'}" FontSize="{DynamicResource Fs10}" Margin="2,4,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="FieldPanel" Margin="0,14,0,0">
                        <TextBlock x:Name="FieldLabel" Text="{loc:Tr '字段'}" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="FieldInput" Style="{StaticResource InputDefault}" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock x:Name="ValueLabel" Text="{loc:Tr '值'}" Style="{StaticResource SectionLabel}" />
                        <TextBox x:Name="ValueInput" Style="{StaticResource InputMultiline}" MinHeight="110" Height="150" />
                        <TextBlock x:Name="ValueHint" FontSize="{DynamicResource Fs10}" Margin="2,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <CheckBox x:Name="OverwriteCheck" Style="{StaticResource CheckBoxModern}" Margin="0,14,0,0"
                              Content="{loc:Tr '若 Key 已存在则覆盖（会先删除原 Key，且不可恢复）'}" FontSize="{DynamicResource Fs12}" />
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="{DynamicResource Fs115}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SizeHintText" Text="{loc:Tr '内容不会上传到外部服务'}" FontSize="{DynamicResource Fs105}"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Content="{loc:Tr '取消'}" IsCancel="True"
                            MinWidth="86" Margin="0,0,8,0" Click="OnCloseClick" />
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="{loc:Tr '创建 Key'}" MinWidth="104"
                            IsDefault="True" Click="OnCreateClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
